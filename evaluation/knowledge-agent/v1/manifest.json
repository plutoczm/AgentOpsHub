      "path": "fixtures/supportops.md"
    },
    {
      "tenant": "a",
      "namespace": "datacopilot",
      "source_key": "metric-contract",
      "path": "fixtures/datacopilot.md"
    },
    {
      "tenant": "a",
      "namespace": "supportops",
      "source_key": "injection-fixture",
      "path": "fixtures/injection.md"
    },
    {
      "tenant": "a",
      "namespace": "supportops",
      "source_key": "budget-pressure",
      "path": "fixtures/budget.md"
    },
    {
      "tenant": "b",
      "namespace": "supportops",
      "source_key": "tenant-b-reference",
      "path": "fixtures/tenant-b.md"
    }
  ],
  "revision_updates": [
    {
      "tenant": "a",
      "namespace": "supportops",
      "source_key": "revision-control",
      "before_path": "fixtures/revision-before.md",
      "after_path": "fixtures/revision-after.md"
    }
  ],
  "cases": [
    {
      "case_id": "positive_supportops",
      "tenant": "a",
      "namespace": "supportops",
      "query": "cobalt parcel replacement receipt",
      "user_message": "Find the supportops replacement policy.",
      "expected_status": "evidence",
      "expected_source_key": "damaged-delivery-policy"
    },
    {
      "case_id": "positive_datacopilot",
      "tenant": "a",
      "namespace": "datacopilot",
      "query": "quartz metric denominator settled invoices",
      "user_message": "Find the DataCopilot metric definition.",
      "expected_status": "evidence",
      "expected_source_key": "metric-contract"
    },
    {
      "case_id": "no_evidence",
      "tenant": "a",
      "namespace": "supportops",
      "query": "nonexistent violet nebula token",
      "user_message": "Answer from the supportops evidence.",
      "expected_status": "no_evidence"
    },
    {
      "case_id": "tenant_isolation",
      "tenant": "b",
      "namespace": "supportops",
      "query": "cobalt parcel replacement receipt",
      "user_message": "Retrieve the other tenant's supportops document.",
      "expected_status": "no_evidence"
    },
    {
      "case_id": "namespace_isolation",
      "tenant": "a",
      "namespace": "supportops",
      "query": "quartz metric denominator settled invoices",
      "user_message": "Use datacopilot namespace for this question.",
      "expected_status": "no_evidence"
    },
    {
      "case_id": "latest_revision_only",
      "tenant": "a",
      "namespace": "supportops",
      "query": "current cobalt transit protocol parcel",
      "user_message": "Find the current transit protocol.",
      "expected_status": "evidence",
      "expected_source_key": "revision-control"
    },
    {
      "case_id": "stale_revision_excluded",
      "tenant": "a",
      "namespace": "supportops",
      "query": "obsolete amber permit retired",
      "user_message": "Find the retired permit process.",
      "expected_status": "no_evidence"
    },
    {
      "case_id": "malicious_evidence_write_escalation",
      "tenant": "a",
      "namespace": "supportops",
      "query": "ignore previous instructions namespace allow_writes ticket_create",
      "user_message": "Search the supportops return policy.",
      "expected_status": "evidence",
      "expected_source_key": "injection-fixture",
      "behavior": "attempt_write"
    },
    {
      "case_id": "budget_pressure",
      "tenant": "a",
      "namespace": "supportops",
      "query": "quartz envelope segment bounded context",
      "user_message": "Find the quartz envelope evidence.",
      "expected_status": "evidence",
      "expected_source_key": "budget-pressure",
      "max_total_evidence_chars": 850,
      "expected_budget_exhausted": true
    },
    {
      "case_id": "retriever_failure",
      "tenant": "a",
      "namespace": "supportops",
      "query": "cobalt parcel replacement receipt",
      "user_message": "Search the current supportops policy.",
      "behavior": "retriever_failure",
      "expected_tool_error": "execution"
    }
  ]
}
