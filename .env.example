# Copy to .env at the repository root. Never commit .env.
AGENTOPSHUB_APP_NAME=AgentOpsHub
AGENTOPSHUB_ENVIRONMENT=development
AGENTOPSHUB_LOG_LEVEL=INFO
AGENTOPSHUB_HOST=127.0.0.1
AGENTOPSHUB_PORT=8000

# Development infrastructure only. Replace this placeholder locally.
# The init-env command generates a random password automatically.
# Shared by the application and Compose; never log the password.
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=agentopshub
POSTGRES_USER=agentopshub
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Application pool and timeout bounds (seconds)
AGENTOPSHUB_DATABASE_POOL_SIZE=5
AGENTOPSHUB_DATABASE_CONNECT_TIMEOUT=3
AGENTOPSHUB_DATABASE_COMMAND_TIMEOUT=5
AGENTOPSHUB_DATABASE_READY_TIMEOUT=2

# Optional internal LLM gateway. All examples are disabled; no startup probes.
# Replace model IDs/endpoints with values for your account. API keys stay local.
AGENTOPSHUB_LLM__PROFILES__deepseek__NAME=deepseek
AGENTOPSHUB_LLM__PROFILES__deepseek__KIND=deepseek
AGENTOPSHUB_LLM__PROFILES__deepseek__BASE_URL=https://api.deepseek.com
AGENTOPSHUB_LLM__PROFILES__deepseek__DEFAULT_MODEL=deepseek-flash
AGENTOPSHUB_LLM__PROFILES__deepseek__ENABLED=false
AGENTOPSHUB_LLM__PROFILES__deepseek__API_KEY=
AGENTOPSHUB_LLM__PROFILES__deepseek__API_KEY_REQUIRED=true

# Qwen base URL depends on account region/workspace; this is NOT a working endpoint.
AGENTOPSHUB_LLM__PROFILES__qwen__NAME=qwen
AGENTOPSHUB_LLM__PROFILES__qwen__KIND=qwen
AGENTOPSHUB_LLM__PROFILES__qwen__BASE_URL=https://your-workspace.example.invalid/compatible-mode/v1
AGENTOPSHUB_LLM__PROFILES__qwen__DEFAULT_MODEL=replace-with-model-id
AGENTOPSHUB_LLM__PROFILES__qwen__ENABLED=false
AGENTOPSHUB_LLM__PROFILES__qwen__API_KEY=
AGENTOPSHUB_LLM__PROFILES__qwen__API_KEY_REQUIRED=true

# Example future local/private endpoint only. No local model server is included.
AGENTOPSHUB_LLM__PROFILES__generic__NAME=generic
AGENTOPSHUB_LLM__PROFILES__generic__KIND=generic
AGENTOPSHUB_LLM__PROFILES__generic__BASE_URL=http://127.0.0.1:11434/v1
AGENTOPSHUB_LLM__PROFILES__generic__DEFAULT_MODEL=replace-with-served-model-id
AGENTOPSHUB_LLM__PROFILES__generic__DEPLOYMENT_TYPE=local
AGENTOPSHUB_LLM__PROFILES__generic__ENABLED=false
AGENTOPSHUB_LLM__PROFILES__generic__API_KEY=
AGENTOPSHUB_LLM__PROFILES__generic__API_KEY_REQUIRED=false

# Capabilities default false. Enable only features supported by the chosen model/server.
# AGENTOPSHUB_LLM__PROFILES__generic__CAPABILITIES__JSON_MODE=true
AGENTOPSHUB_LLM__PROFILES__deepseek__CAPABILITIES__TOOL_CALLING=true
# Route order is the explicit allowed fallback/data-sharing path.
AGENTOPSHUB_LLM__ROUTES__high-quality__CANDIDATES=[{"provider":"deepseek"},{"provider":"qwen"}]
AGENTOPSHUB_LLM__ROUTES__private-local__CANDIDATES=[{"provider":"generic"}]
AGENTOPSHUB_LLM__TOTAL_TIMEOUT=90
AGENTOPSHUB_LLM__RETRY__MAX_ATTEMPTS=2
AGENTOPSHUB_LLM__PROFILES__deepseek__DEEPSEEK_OPTIONS__THINKING_MODE=disabled
AGENTOPSHUB_LLM__PROFILES__deepseek__CAPABILITIES__TEMPERATURE=true
AGENTOPSHUB_LLM__PROFILES__deepseek__CAPABILITIES__JSON_MODE=false
AGENTOPSHUB_LLM__PROFILES__deepseek__CAPABILITIES__STRUCTURED_OUTPUT=false
AGENTOPSHUB_LLM__PROFILES__deepseek__PRICING__deepseek-flash__INPUT_PER_MILLION=0.30
AGENTOPSHUB_LLM__PROFILES__deepseek__PRICING__deepseek-flash__OUTPUT_PER_MILLION=1.20
AGENTOPSHUB_LLM__PROFILES__deepseek__PRICING__deepseek-flash__CURRENCY=USD
AGENTOPSHUB_LLM__PROFILES__deepseek__PRICING__deepseek-flash__EFFECTIVE_DATE=2026-09-10
AGENTOPSHUB_LLM__PROFILES__deepseek__PRICING__deepseek-flash__SOURCE=https://api-docs.deepseek.com/quick_start/pricing
AGENTOPSHUB_LLM__ROUTES__agent-eval__CANDIDATES=[{"provider":"deepseek","model":"deepseek-flash"}]
