# Copy to .env at the repository root. Never commit .env.
AGENTOPSHUB_APP_NAME=AgentOpsHub
AGENTOPSHUB_ENVIRONMENT=development
AGENTOPSHUB_LOG_LEVEL=INFO
AGENTOPSHUB_HOST=127.0.0.1
AGENTOPSHUB_PORT=8000

# Development infrastructure only. Replace this placeholder locally.
# The init-env command generates a random password automatically.
# Shared by the application and Compose; never log the password.
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=agentopshub
POSTGRES_USER=agentopshub
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Reserved for the future gateway; Phase 0 makes no model calls.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Application pool and timeout bounds (seconds)
AGENTOPSHUB_DATABASE_POOL_SIZE=5
AGENTOPSHUB_DATABASE_CONNECT_TIMEOUT=3
AGENTOPSHUB_DATABASE_COMMAND_TIMEOUT=5
AGENTOPSHUB_DATABASE_READY_TIMEOUT=2
